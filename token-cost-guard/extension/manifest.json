{
  "manifest_version": 3,
  "name": "Token Cost Guard",
  "version": "1.0.0",
  "description": "Side-by-side live dashboard for your Token Cost Guard proxy: spend, budgets and request ledger.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Token Cost Guard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
